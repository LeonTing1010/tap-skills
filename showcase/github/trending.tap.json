{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "id": "https://taprun.dev/taps/github/trending",
  "type": "Annotation",
  "motivation": "tap:executing",
  "target": "https://taprun.dev/taps/github/trending",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "github",
    "name": "trending",
    "intent": "read",
    "ops": [
      {
        "op": "compute",
        "expr": "$fromMillis($millis() - args.days * 86400000) ~> $substring(0, 10)",
        "save": "since"
      },
      {
        "op": "compute",
        "expr": "'created:>' & since & ' stars:>=' & $string(args.min_stars)",
        "save": "q"
      },
      {
        "op": "fetch",
        "url": "https://api.github.com/search/repositories?q={{$encodeUrlComponent(q)}}&sort=stars&order=desc&per_page={{args.per_page}}",
        "headers": {
          "Accept": "application/vnd.github.v3+json"
        },
        "format": "json",
        "save": "data"
      },
      {
        "op": "compute",
        "expr": "data.items ? data.items : []",
        "save": "raw"
      },
      {
        "op": "filter",
        "on": "raw",
        "expr": "$contains($lowercase(($exists(description) ? description : '') & ' ' & $join(($exists(topics) ? topics : []), ' ')), /\\b(ai|saas|llm|ml|gpt|chatbot|automation|api|dashboard|analytics|productivity|finance|health|education|devtool|developer|seo|crm|workflow|ecommerce)\\b/)"
      },
      {
        "op": "project",
        "shape": {
          "slug": "$string(full_name)",
          "description": "$substring($string(($exists(description) ? description : '')), 0, 200)",
          "stars": "$string(stargazers_count)",
          "language": "$string(($exists(language) ? language : ''))",
          "topics": "$join(($exists(topics) ? topics : []), ',')",
          "created_at": "$string(created_at)",
          "url": "$string(html_url)"
        }
      }
    ],
    "description": "GitHub repos created in the last N days with ≥ min_stars, filtered to AI/SaaS/devtool niches via topic+description keyword match. Supply-side signal for solo builder category emergence.",
    "columns": [
      "slug",
      "description",
      "stars",
      "language",
      "topics",
      "created_at",
      "url"
    ],
    "args": {
      "days": {
        "type": "int",
        "default": 7,
        "description": "Lookback window in days"
      },
      "min_stars": {
        "type": "int",
        "default": 5,
        "description": "Minimum stars to include"
      },
      "per_page": {
        "type": "int",
        "default": 50,
        "description": "Max results from API"
      }
    },
    "health": {
      "min_rows": 1,
      "non_empty": [
        "slug"
      ]
    },
    "examples": [
      {}
    ]
  },
  "generator": {
    "id": "https://taprun.dev/migrate",
    "type": "SoftwareAgent",
    "version": "declared-source"
  },
  "created": "2026-04-20T03:01:41.157Z"
}
