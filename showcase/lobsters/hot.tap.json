{
  "@context": [
    "http://www.w3.org/ns/anno.jsonld",
    "https://taprun.dev/ns/tap-v1"
  ],
  "id": "https://taprun.dev/taps/lobsters/hot",
  "type": "Annotation",
  "motivation": "tap:executing",
  "target": "https://lobste.rs/rss",
  "body": {
    "type": "tap:ExecutionPlan",
    "site": "lobsters",
    "name": "hot",
    "intent": "read",
    "description": "Lobsters hot stories - Frontpage stories from Lobsters tech community, extracted via RSS feed",
    "ops": [
      {
        "op": "fetch",
        "url": "https://lobste.rs/rss",
        "format": "text",
        "save": "xml"
      },
      {
        "op": "parseXML",
        "source": "xml",
        "itemTags": ["item", "entry"],
        "fields": {
          "title": "title",
          "link": { "tag": "link", "attr": "href" },
          "comments_url": "comments",
          "author": "author",
          "date": { "tag": ["pubDate", "published", "updated"] },
          "categories": "category"
        },
        "save": "raw"
      },
      {
        "op": "filter",
        "on": "raw",
        "expr": "title and title != ''",
        "save": "items"
      },
      {
        "op": "compute",
        "expr": "$map(items, function($v, $i) { $merge([{ \"rank\": $string($i + 1) }, $v]) })"
      }
    ],
    "health": {
      "min_rows": 5,
      "non_empty": [
        "title",
        "link"
      ]
    },
    "examples": [
      {}
    ]
  },
  "generator": {
    "id": "https://taprun.dev/migrate",
    "type": "SoftwareAgent",
    "version": "declared-source"
  }
}
